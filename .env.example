# Copy to .env and fill in what you use. Nothing here is required if you run Ollama
# or sign in to one of the subscription CLIs below.

# OpenAI API key (billed per token, not a ChatGPT subscription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic API key (billed per token, not a Claude subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Subscription connectors
# -----------------------------------------------------------------
# A ChatGPT Plus/Pro or Claude Pro/Max subscription cannot be used as a
# normal API key. aivillage can instead drive the official CLIs, which reuse
# the login those apps already store on this machine:
#
#   npm install -g @anthropic-ai/claude-code
#   claude          # sign in once, then use `provider = "claude_cli"`
#
#   npm install -g @openai/codex
#   codex           # sign in once, then use `provider = "codex_cli"`
#
# `provider = "subscription"` tries Claude first and falls back to Codex.
# Each villager line is a separate short CLI call, so expect a few seconds of
# latency and normal subscription rate limits.
# -----------------------------------------------------------------

# Local Ollama (default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
